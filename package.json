{
  "name": "wp70-archive",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed-places": "node --env-file-if-exists=.env scripts/seed-places.ts",
    "db:seed-fake": "node --env-file-if-exists=.env scripts/seed-fake-photos.ts",
    "db:clean-fake": "node --env-file-if-exists=.env scripts/seed-fake-photos.ts --clean",
    "db:test": "node --env-file-if-exists=.env scripts/test-db.ts",
    "db:timings": "node --env-file-if-exists=.env scripts/time-queries.ts"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pg": "^8.23.0",
    "polylabel": "^2.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
