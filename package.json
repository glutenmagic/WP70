{
  "name": "wp70-archive",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed-places": "node --env-file-if-exists=.env scripts/seed-places.ts",
    "db:seed-fake": "node --env-file-if-exists=.env scripts/seed-fake-photos.ts",
    "db:clean-fake": "node --env-file-if-exists=.env scripts/seed-fake-photos.ts --clean",
    "db:test": "node --env-file-if-exists=.env scripts/test-db.ts",
    "db:timings": "node --env-file-if-exists=.env scripts/time-queries.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
