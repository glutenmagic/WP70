# Scripts in scripts/ talk to the database through ONE of these backends.

# Option A: Supabase Management API (HTTPS only; works where Postgres ports are blocked).
# Personal access token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=fuwglxpmyytybaxdouyl

# Option B: direct Postgres connection (local stack or a network that allows port 5432).
# Takes precedence over option A when set.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
